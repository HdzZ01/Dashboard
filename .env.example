# Copie para .env e ajuste. O .env não vai para o git.

# --- Banco (usado pelo Postgres do compose) ---
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital

# --- Conexão da aplicação/ETL ---
# Local (fora do Docker): aponta para a porta publicada pelo compose (5433).
# Dentro do Docker: o compose sobrescreve para postgresql+pg8000://.../@db:5432/...
DATABASE_URL=postgresql+pg8000://hospital:hospital@localhost:5433/hospital

# --- Fonte de dados ---
CSV_PATH=data/saude_processada.csv

# --- Parâmetros de análise (antes: hardcoded no script) ---
MIN_ANO_ATENDIMENTO=2015
TOP_N_PADRAO=10
ETL_CHUNK_SIZE=20000
